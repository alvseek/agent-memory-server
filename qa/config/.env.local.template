# Committed config = deploy target. This template is the swap-IN for local mode.
# Never commit actual secrets — placeholders only. (Munnin v1 has no secrets.)

# Server bind (defaults shown)
MUNNIN_HOST=127.0.0.1
MUNNIN_PORT=8200

# Tenancy — stamped server-side, never from request input
MUNNIN_USER_ID=alvi

# SQLite store (gitignored runtime data)
MUNNIN_DB_PATH=data/valaskjalf-memory.db

# Served content — the control-files submodule
MUNNIN_CONTENT_ROOT=control-files

# Importer seed source — the real markdown memory tree
MUNNIN_IMPORT_SOURCE=~/.claude/@agent-memory
