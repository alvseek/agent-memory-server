[Unit]
Description=Munnin — agent-memory MCP server
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/agent-memory-server
EnvironmentFile=/home/deploy/agent-memory-server/deploy/munnin.env
# Run the venv python directly (uv sync creates .venv) — no uv needed at runtime.
# Single worker: one writer per SQLite file (Valaskjalf/memory, WAL).
ExecStart=/home/deploy/agent-memory-server/.venv/bin/python -m munnin
Restart=on-failure
RestartSec=3
# Hard ceiling — protects invintiry/telegent from a Munnin leak (RAM check 2026-08-09: 461 MB avail).
MemoryMax=200M

[Install]
WantedBy=multi-user.target
