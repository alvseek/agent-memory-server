# Munnin runtime settings. Copy to .env for local Compose overrides.
#
# There are NO SECRETS in this file. v1 is single-fleet with no auth by design.
# When WorkOS lands, its client secret arrives at RUNTIME — via the orchestrator's
# environment or a mounted file — and never through ENV or ARG in the image.

# Bind address INSIDE the container. Must be 0.0.0.0: the application's own
# default of 127.0.0.1 binds the container's loopback and is unreachable.
MUNNIN_HOST=0.0.0.0
MUNNIN_PORT=8200

# Host-side published port. Separate from MUNNIN_PORT because the host-native
# Munnin may already hold 8200 on a development machine; the container port
# does not move.
MUNNIN_HOST_PORT=8200

# Single constant tenant, stamped server-side and never read from agent input.
MUNNIN_USER_ID=alvi

# Valaskjalf/memory. Keep it under /app/data — that DIRECTORY is the named
# volume, which is what keeps the WAL sidecars with the database.
MUNNIN_DB_PATH=/app/data/valaskjalf-memory.db

# Served framework content (the control-files submodule, baked into the image).
MUNNIN_CONTENT_ROOT=/app/control-files
