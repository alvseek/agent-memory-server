# Munnin runtime settings — every MUNNIN_* the server reads, shown with the
# local-mode values compose.yaml runs with.
#
# How it is consumed: compose.yaml reads MUNNIN_HOST_PORT and MUNNIN_USER_ID
# from a .env beside it and pins the rest, because those describe the container
# rather than a choice. A bare process (`uv run python -m munnin`) reads all of
# them from its environment.
#
# There are NO SECRETS here, in either mode. Munnin is a resource server: it
# verifies tokens against an issuer's PUBLIC JWKS and holds no client credential.

# ---- Mode ---------------------------------------------------------------------
# off   = local mode. No issuer, no sign-in; every call acts as MUNNIN_USER_ID.
#         Accepted only while MUNNIN_PUBLIC_BASE_URL names this machine AND the
#         process binds loopback (or MUNNIN_LOCAL_BIND_ALL=1 states that something
#         in front of it keeps the port local). Otherwise it refuses to start.
# unset = token mode, the default. An issuer must be configured or the server
#         refuses to start; every /mcp and /api call needs a bearer token. Any
#         value other than the literal `off` reads as token mode — a typo keeps
#         authentication on, never off.
MUNNIN_AUTH=off

# ---- Reachability -------------------------------------------------------------
# Bind address. The application's own default is 127.0.0.1. Inside a container
# it must be 0.0.0.0 or nothing outside the container can reach it — which is
# exactly the case MUNNIN_LOCAL_BIND_ALL exists for.
MUNNIN_HOST=0.0.0.0
MUNNIN_PORT=8200

# Host-side published port (compose only). Separate from MUNNIN_PORT because a
# host-native Munnin may already hold 8200; the container port does not move.
MUNNIN_HOST_PORT=8200

# The URL this server is addressed at. Tokens are bound to `<this>/mcp` as their
# audience, so in token mode it must match the resource identifier registered
# with the issuer character for character (no trailing slash on the identifier).
# In local mode it must name this machine.
MUNNIN_PUBLIC_BASE_URL=http://127.0.0.1:8200

# Local mode's acknowledgement that a 0.0.0.0 bind is still local: compose
# publishes the port on 127.0.0.1 only, so the container may bind every interface.
# An acknowledgement, never a detection — the server cannot see what publishes its
# port. Never set this on a process that binds 0.0.0.0 with nothing in front of it.
MUNNIN_LOCAL_BIND_ALL=1

# ---- Tenant and storage -------------------------------------------------------
# The one tenant local mode serves, and the tenant the importer stamps records
# with. In token mode the server never reads it — the tenant comes from the token.
MUNNIN_USER_ID=alvi

# Valaskjalf/memory. Keep it under /app/data — that DIRECTORY is the named volume,
# which keeps SQLite's WAL sidecars beside the database.
MUNNIN_DB_PATH=/app/data/valaskjalf-memory.db

# Served framework content (the control-files submodule, copied into the image).
MUNNIN_CONTENT_ROOT=/app/control-files

# ---- Token mode (hosted) ------------------------------------------------------
# Drop MUNNIN_AUTH and MUNNIN_LOCAL_BIND_ALL, set the public URL to the real
# hostname, and name the issuer. Logto's OIDC paths are derived from the endpoint;
# the audience binds itself to `<public URL>/mcp`.
# MUNNIN_PUBLIC_BASE_URL=https://munnin.example.com
# MUNNIN_LOGTO_ENDPOINT=https://auth.example.com

# Optional. Overrides the audience Logto tokens are checked against. Normally
# empty. Comma-separated, so a renamed identifier can be accepted beside the old
# one while every client re-mints its tokens.
# MUNNIN_LOGTO_AUDIENCE=https://munnin.example.com/mcp

# Optional. A WorkOS AuthKit tenant: the issuer when it is the only one set, and a
# verify-only fallback while Logto is configured beside it — how an issuer gets
# replaced without locking anyone out.
# MUNNIN_AUTHKIT_DOMAIN=https://example.authkit.app

# ---- Developer ----------------------------------------------------------------
# FastAPI's /openapi.json, /docs and /redoc. They sit outside the auth guard, so
# they are present or absent, never protected. Off by default.
# MUNNIN_DOCS=1
